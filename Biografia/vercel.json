{
  "rewrites": [
    { "source": "/it", "destination": "/" },
    { "source": "/en", "destination": "/" },
    { "source": "/es", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
